{
  "name": "f-commerce-os",
  "version": "0.2.0",
  "private": true,
  "description": "Tenant-aware commerce operations OS for Bangladesh social sellers",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && node smoke-test.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run db:validate && npm run typecheck",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:init": "prisma migrate dev --name init",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "verify": "npm run check && npm run lint && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^2.0.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.4.0",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "next": "^16.2.9",
    "pg": "^8.16.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.186.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.186.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.2.9",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
