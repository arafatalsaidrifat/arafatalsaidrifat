# Core
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="F-Commerce OS"
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=postgresql://fcommerce:fcommerce@localhost:5432/fcommerce?schema=public
# Set true only when you want open self-service registration. Tenant access is still membership-checked.
ALLOW_PUBLIC_SIGNUP=false
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Resend account verification and password recovery
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Local Docker Compose only. Generate unique values before starting containers; never reuse them in production.
POSTGRES_USER=fcommerce
POSTGRES_PASSWORD=
POSTGRES_DB=fcommerce
REDIS_PASSWORD=

# Jobs (optional in local/dev; durable DB outbox remains available)
REDIS_URL=redis://:CHANGE_ME@localhost:6379
CRON_SECRET=

# Meta / Messenger / Instagram / WhatsApp: app review + merchant tokens required
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_APP_ID=

# LLM / LangGraph (optional; no fake provider success when absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Private payment proof storage (S3-compatible); bucket must not be public
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# MFS providers — configure only with approved merchant credentials
BKASH_API_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_API_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
ROCKET_VERIFICATION_URL=
ROCKET_API_KEY=
OCR_API_URL=
OCR_API_KEY=

# Courier providers. Secrets remain server-side.
PATHAO_API_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# JSON map verified with current Pathao city/zone/area API, keyed by normalized city name
PATHAO_LOCATION_MAP_JSON=
STEADFAST_API_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_LIVE_BOOKING_ENABLED=false
SHIPROCKET_COUNTRY=India
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PINCODE=
